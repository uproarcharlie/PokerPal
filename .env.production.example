# Production Environment Configuration
# Copy this to .env in production and fill in with your actual values

# Database Configuration
# For Railway: Copy from PostgreSQL service variables
# For Neon: Get from https://neon.tech
# For DigitalOcean: Use your VPS PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:port/database

# Server Configuration
PORT=3000
NODE_ENV=production

# Session Secret (REQUIRED - Generate a strong random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_production_session_secret_here_change_this

# Google Maps API Key for address autocomplete
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: PostgreSQL Password (for docker-compose)
POSTGRES_PASSWORD=your_secure_postgres_password

# Boot and runtime settings (optional; the defaults suit Railway)
# MIGRATE_ON_BOOT: apply migrations/*.sql at every start, before listening (default true).
#   false starts the server without migrating: only while a failing migration is being fixed, and only
#   if the database already has the schema this build needs. See DEPLOYMENT.md, "When a boot migration fails".
# MIGRATE_ON_BOOT=true
# TRUST_PROXY: Express "trust proxy", i.e. how many proxies sit in front of the app, so client IPs
#   and https are read correctly (default 1: Railway's edge). Also true, false, or a list of addresses.
# TRUST_PROXY=1
# DB_POOL_MAX: the most Postgres connections the app holds open (default 10).
# DB_POOL_MAX=10
