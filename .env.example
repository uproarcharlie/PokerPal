# Database Configuration
# Get a free PostgreSQL database from https://neon.tech
# Or use local PostgreSQL: postgresql://postgres:password@localhost:5432/pokerpal
DATABASE_URL=postgresql://user:password@host:port/database

# Server Configuration
PORT=3000
NODE_ENV=development

# Google Maps API Key for address autocomplete
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Session Secret (REQUIRED for production - generate a random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret_here_change_in_production

# Image storage: Cloudflare R2 (https://dash.cloudflare.com/r2) or local disk
# Production keeps images in R2 and needs all five R2_* values: set them all or none (the server
# refuses to start with only some). Elsewhere R2 is used only with USE_CLOUD_STORAGE=true, which
# also needs all five; otherwise images are saved under UPLOAD_DIR (below).
# R2_PUBLIC_URL is where browsers load images from: the bucket's public r2.dev URL or a custom
# domain such as https://images.lovepoker.club. Never the <account>.r2.cloudflarestorage.com API host.
USE_CLOUD_STORAGE=false
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://images.your-domain.com
# UPLOAD_DIR: the directory for images on local disk (default ./uploads), served at /uploads.
#   In production it is the explicit opt-in to local disk without R2, for a persistent volume only:
#   with neither R2 nor UPLOAD_DIR, production answers image uploads with 503 instead of saving them
#   where the next redeploy wipes them.
# UPLOAD_DIR=uploads

# Boot and runtime settings (optional; the defaults suit Railway)
# MIGRATE_ON_BOOT: apply migrations/*.sql at every start, before listening (default true).
#   false starts the server without migrating: only while a failing migration is being fixed, and only
#   if the database already has the schema this build needs. See DEPLOYMENT.md, "When a boot migration fails".
# MIGRATE_ON_BOOT=true
# TRUST_PROXY: Express "trust proxy", i.e. how many proxies sit in front of the app, so client IPs
#   and https are read correctly (default 1: Railway's edge). Also true, false, or a list of addresses.
# TRUST_PROXY=1
# CLOUDFLARE_ORIGIN_SECRET: a random secret (16+ characters) that the site's Cloudflare zone adds to
#   every request as the X-Origin-Auth header (a Transform Rule). When set, the rate limits believe
#   the visitor address in CF-Connecting-IP only from requests carrying it, so nobody reaching the
#   Railway origin some other way can choose their own. Unset: believed from any Cloudflare address.
#   See DEPLOYMENT.md.
# CLOUDFLARE_ORIGIN_SECRET=
# DB_POOL_MAX: the most Postgres connections the app holds open (default 10).
# DB_POOL_MAX=10
# RATE_LIMITS_ENABLED: the API rate limits (sign-in failures, anonymous sign-ups and uploads, and an
#   overall cap per visitor). Unset means on, except under NODE_ENV=test; false turns them off, for a
#   production-mode run that is not the live site.
# RATE_LIMITS_ENABLED=true
# RATE_LIMIT_PUBLIC_WRITE: player self-service writes (new player, sign-up, re-buy/add-on/knockout
#   requests) per address, or per signed-in account, per 15 minutes (default 300; sign-ups and requests
#   are counted per tournament, new players separately). Raise it for a very big night on one venue Wi-Fi.
# RATE_LIMIT_PUBLIC_WRITE=300
# RATE_LIMIT_LIVE: live-page polling per address, or per signed-in account, per 15 minutes (default
#   10000: about 27 phones on one address watching the tournament page non-stop).
# RATE_LIMIT_LIVE=10000
