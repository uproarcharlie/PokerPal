{
  "name": "lovepoker-club",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Where Poker Communities Thrive - Tournament management for grassroots poker clubs",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "rm -rf dist && vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --external:vite --external:nanoid --external:../vite.config.js && mkdir -p dist/migrations && cp migrations/*.sql dist/migrations/",
    "start": "NODE_ENV=production node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:web": "vitest run --project web",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down",
    "seed:tournament": "NODE_ENV=test tsx scripts/seed/tournament-lifecycle.ts",
    "seed:tournament:cleanup": "NODE_ENV=test tsx scripts/seed/tournament-lifecycle-cleanup.ts",
    "seed:tournament:setup": "NODE_ENV=test tsx scripts/seed/tournament-setup.ts",
    "seed:tournament:active": "NODE_ENV=test tsx scripts/seed/tournament-in-progress.ts",
    "seed:tournament:final": "NODE_ENV=test tsx scripts/seed/tournament-final-table.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@googlemaps/js-api-loader": "^2.0.1",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@tanstack/react-query": "^5.60.5",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.39.1",
    "drizzle-zod": "^0.7.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.453.0",
    "multer": "^2.4.0",
    "pg": "^8.16.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.4",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.3.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/google.maps": "^3.58.1",
    "@types/multer": "^2.0.0",
    "@types/node": "20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.12",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "nanoid": "^5.1.16",
    "pg-connection-string": "^2.9.1",
    "postcss": "^8.5.30",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
