{
  "name": "lovepoker-club",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Where Poker Communities Thrive - Tournament management for grassroots poker clubs",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "rm -rf dist && vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --external:vite --external:nanoid --external:../vite.config.js && mkdir -p dist/migrations && cp migrations/*.sql dist/migrations/",
    "start": "NODE_ENV=production node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:web": "vitest run --project web",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run build",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down",
    "seed:tournament": "NODE_ENV=test tsx scripts/seed/tournament-lifecycle.ts",
    "seed:tournament:cleanup": "NODE_ENV=test tsx scripts/seed/tournament-lifecycle-cleanup.ts",
    "seed:tournament:setup": "NODE_ENV=test tsx scripts/seed/tournament-setup.ts",
    "seed:tournament:active": "NODE_ENV=test tsx scripts/seed/tournament-in-progress.ts",
    "seed:tournament:final": "NODE_ENV=test tsx scripts/seed/tournament-final-table.ts"
  },
